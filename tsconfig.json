{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2022"],
        "module": "commonjs",
        "outDir": "./out",
        "resolveJsonModule": true,
        "rootDir": "./src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "exclude": ["node_modules", "out", "tests"],
    "include": ["src/**/*"]
}
